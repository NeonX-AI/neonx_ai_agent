{
  "name": "openclaw-message-listener",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && cp openclaw.plugin.json dist/",
    "dev": "tsc --watch"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "hooks": {
      "allowConversationAccess": true
    },
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    }
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
